# Google OAuth "Web application" client. Defaults to the one the extension's
# web sign-in already uses, so the web app reads the same Drive app-data file.
# Add this site's origin under that client's "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=

# FlickCue's Cloudflare Worker. It must allow this site's origin (see README).
VITE_PROXY_URL=https://api.flickcue.in

# Set to 1 to show the "Add reminders to Google Calendar" setting. Needs the Google
# Calendar API enabled on the OAuth client's project, and the calendar.app.created
# permission on its consent screen (people on its test-user list can use it first).
VITE_CALENDAR_MIRROR=

# Set to 1 to keep people signed in past Google's one-hour token (a refresh token kept
# on the device, renewed through the title service). Needs the title service updated and
# the privacy page changed first: see README, "Staying signed in".
VITE_LONG_SIGNIN=
