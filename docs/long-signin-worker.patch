diff --git a/tests/proxy-oauth.test.js b/tests/proxy-oauth.test.js
new file mode 100644
index 0000000..0046066
--- /dev/null
+++ b/tests/proxy-oauth.test.js
@@ -0,0 +1,48 @@
+// The proxy's OAuth routes, as the extension and the web app call them.
+//
+//   node tests/proxy-oauth.test.js
+const results = [];
+const check = (name, pass) => results.push([name, Boolean(pass)]);
+
+(async () => {
+  const { default: worker } = await import("../proxy/src/index.js");
+  const env = { OAUTH_CLIENT_ID: "client-id", OAUTH_CLIENT_SECRET: "client-secret" };
+  const sent = [];
+  globalThis.fetch = async (url, init) => {
+    sent.push({ url: String(url), body: new URLSearchParams(init.body) });
+    return new Response(JSON.stringify({ access_token: "a", refresh_token: "r" }), { status: 200, headers: { "Content-Type": "application/json" } });
+  };
+  const call = (path, body, origin) => worker.fetch(new Request(`https://proxy.example/oauth/${path}`, {
+    method: "POST",
+    headers: { "Content-Type": "application/json", ...(origin ? { Origin: origin } : {}) },
+    body: JSON.stringify(body)
+  }), env);
+
+  // The web app: a Google popup code, no verifier, its own origin as redirect_uri.
+  let reply = await call("token", { code: "c1", redirect_uri: "https://flickcue.in" }, "https://flickcue.in");
+  check("the web app may exchange a code", reply.status === 200);
+  check("the secret is added by the proxy", sent.at(-1).body.get("client_secret") === "client-secret" && sent.at(-1).body.get("client_id") === "client-id");
+  check("an absent verifier is left out, not sent empty", !sent.at(-1).body.has("code_verifier"));
+  check("the grant type is authorization_code", sent.at(-1).body.get("grant_type") === "authorization_code");
+  check("CORS answers the web app", reply.headers.get("Access-Control-Allow-Origin") === "https://flickcue.in");
+
+  const before = sent.length;
+  reply = await call("token", { code: "c1", redirect_uri: "https://evil.example/cb" }, "https://flickcue.in");
+  check("a web page can't present another redirect_uri", reply.status === 400 && sent.length === before);
+
+  reply = await call("refresh", { refresh_token: "r1" }, "https://flickcue.in");
+  check("the web app may renew access", reply.status === 200 && sent.at(-1).body.get("grant_type") === "refresh_token" && sent.at(-1).body.get("refresh_token") === "r1");
+
+  reply = await call("refresh", { refresh_token: "r1" }, "https://evil.example");
+  check("another website is still refused", reply.status === 403);
+
+  // The extension: unchanged, verifier and redirect_uri pass through.
+  reply = await call("token", { code: "c2", code_verifier: "v", redirect_uri: "https://id.chromiumapp.org/" }, "chrome-extension://abc");
+  check("the extension's exchange still works", reply.status === 200 && sent.at(-1).body.get("code_verifier") === "v" && sent.at(-1).body.get("redirect_uri") === "https://id.chromiumapp.org/");
+  reply = await call("refresh", { refresh_token: "r2" });
+  check("a call with no Origin (the extension's service worker) still works", reply.status === 200);
+
+  const failed = results.filter(([, pass]) => !pass);
+  for (const [name, pass] of results) console.log(`${pass ? "ok  " : "FAIL"} ${name}`);
+  process.exit(failed.length ? 1 : 0);
+})().catch((error) => { console.error(error); process.exit(1); });
